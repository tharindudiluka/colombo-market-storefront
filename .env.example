SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=shpat_your_storefront_token_here
SHOPIFY_STOREFRONT_API_VERSION=2025-10

# Customer Account API (OAuth login/orders/addresses) — from the Shopify admin's
# Headless sales channel → Customer Account API settings. See README for setup steps.
SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_SECRET=
SHOPIFY_CUSTOMER_ACCOUNT_API_SHOP_ID=
SHOPIFY_CUSTOMER_ACCOUNT_API_VERSION=2025-10

# Full site origin (no trailing slash) — used to build the OAuth redirect_uri. Must match
# a redirect URI registered in the Customer Account API client (HTTPS only in staging/prod).
SITE_URL=http://localhost:3000

# Server-only /api/revalidate bearer secret. Use a random value of at least 32
# characters in .env.local / Vercel environment settings; never commit its value.
REVALIDATION_SECRET=

